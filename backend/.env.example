# Environment Configuration for Failure Replay Lab
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1

# MongoDB Connection URI
# Local MongoDB default:
MONGODB_URI=mongodb://localhost:27017/failure_replay_lab

# Or MongoDB Atlas Free Tier URI example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/failure_replay_lab?retryWrites=true&w=majority

# Database name
DB_NAME=failure_replay_lab

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
